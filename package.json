{
  "name": "firebase-deploy-changes",
  "version": "0.1.0",
  "description": "Deploy only the Firebase Cloud Functions whose code actually changed",
  "keywords": [
    "firebase",
    "cloud-functions",
    "deploy",
    "static-analysis"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sisu/firebase-deploy-changes.git"
  },
  "license": "MIT",
  "type": "module",
  "bin": {
    "fdc": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": "^22.18.0 || >=24.11.0"
  },
  "scripts": {
    "build": "node -e \"fs.rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.build.json",
    "prepublishOnly": "npm run build",
    "typecheck": "tsc",
    "test": "node --test \"test/*.test.ts\"",
    "test:firestore": "firebase emulators:exec --only firestore --project demo-fdc \"node --test test/firestore.test.ts\""
  },
  "dependencies": {
    "@babel/generator": "^8.0.6",
    "@babel/parser": "^8.0.6",
    "@babel/traverse": "^8.0.6",
    "@babel/types": "^8.0.6",
    "@google-cloud/firestore": "^9.2.0",
    "picomatch": "^4.0.7"
  },
  "devDependencies": {
    "@types/babel__generator": "^7.27.0",
    "@types/babel__traverse": "^7.28.0",
    "@types/node": "^26.6.2",
    "@types/picomatch": "^4.0.3",
    "typescript": "^7.0.2"
  }
}
